# -----------------------------------------------------------------------------
# PRODUCTION ENVIRONMENT VARIABLES
# -----------------------------------------------------------------------------

# Database (must match the credentials defined in docker-compose.prod.yml environment block)
POSTGRES_USER=invoiceai_prod_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=invoiceai_prod

# The FastAPI app uses DATABASE_URL

# File Storage Configuration (Internal container path)
FILE_STORAGE_PATH=/app/storage/invoices
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Security & CORS
# Replace the example URL with the actual InvoiceAI frontend origin before deployment.
CORS_ORIGINS=https://invoiceai-frontend.example.com

# Gemini API Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
